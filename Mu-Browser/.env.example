# Todo es opcional: sin .env el juego arranca con estos valores por defecto.
# Copiar a .env sólo para cambiar algo.

# Base de datos. MySQL no publica ningún puerto (sólo lo ve mu-web), pero conviene cambiar las contraseñas
# antes del primer arranque: después quedan guardadas en el volumen de MySQL.
MYSQL_ROOT_PASSWORD=mu_browser_root
MYSQL_DATABASE=mubrowser
MYSQL_USER=mu_browser
MYSQL_PASSWORD=mu_browser

# Puerto publicado en el host (8085 lo usa el panel de Mu-Linux-97K)
WEB_PORT=8086
# Vacío: se genera solo en el primer arranque. Si se pone a mano: openssl rand -hex 32
SESSION_SECRET=
# 1 solo si hay un reverse proxy propio delante (usa X-Forwarded-For / X-Forwarded-Proto)
TRUST_PROXY=0
# Zona horaria del servidor y de las fechas que se muestran (las horas de los eventos siempre son UTC)
TZ=America/Argentina/Buenos_Aires
TIMEZONE=America/Argentina/Buenos_Aires

# Reverse proxy en la red externa proxy_net (convención de Mu-Linux-97K): descomentar.
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
