{
    "name": "mu/browser",
    "description": "Juego de navegador basado en MU Online (reescritura del proyecto de 2011)",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Mu\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Mu\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
