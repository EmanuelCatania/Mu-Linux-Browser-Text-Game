{% extends 'layout.twig' %}

{% block title %}{{ t(title_key) }} - {{ t('site.title') }}{% endblock %}

{% block content %}
<div class="ucp">
    <h1 class="title-bar">{{ t(title_key) }}</h1>
    <div class="ucp-back">
        <div class="ucp-main">
            <p>{{ t(message_key) }}</p>
            <p><a href="/">{{ t('error.back_home') }}</a></p>
        </div>
    </div>
</div>
{% endblock %}
